# Paste real values into a local `.env` file (never commit it).
# Copy this file to `.env` and fill in each value.

# --- Clerk (https://dashboard.clerk.com) ---
# Required to run the app at all. Get these from your Clerk application > API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Neon Postgres (https://console.neon.tech) ---
# Pooled connection string for your Neon project.
DATABASE_URL=

# --- Stripe (https://dashboard.stripe.com) ---
# Use TEST keys now (sk_test_..., pk_test_..., whsec_...).
# Switch to LIVE keys only when you are ready to take real payments.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- App ---
# Public base URL of the deployed app (used for Stripe redirects and webhooks).
NEXT_PUBLIC_APP_URL=http://localhost:3000
